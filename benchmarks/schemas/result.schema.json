{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiscale-optics-agent.local/schemas/m1-result.schema.json",
  "title": "M1 baseline benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"enum": ["L1-RAY-01", "L1-WAVE-01", "L2-COUPLER-01"]},
    "protocol_id": {
      "enum": [
        "M1-BASELINE-CPU-V1",
        "M1-BASELINE-CPU-V2",
        "M2-COUPLER-CPU-V1"
      ]
    },
    "protocol_amendment": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "blocked"]},
    "accuracy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["oracle", "metrics", "tolerances", "pass"],
      "properties": {
        "oracle": {"type": "string", "minLength": 1},
        "metrics": {"type": "object"},
        "tolerances": {"type": "object"},
        "pass": {"type": "boolean"}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmup_runs",
        "measured_repeats",
        "samples_seconds",
        "statistics",
        "peak_memory"
      ],
      "properties": {
        "warmup_runs": {"type": "integer", "minimum": 1},
        "measured_repeats": {"type": "integer", "minimum": 5},
        "samples_seconds": {
          "type": "array",
          "minItems": 5,
          "items": {"type": "number", "minimum": 0}
        },
        "statistics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["median_seconds", "minimum_seconds", "p95_seconds"],
          "properties": {
            "median_seconds": {"type": "number", "minimum": 0},
            "minimum_seconds": {"type": "number", "minimum": 0},
            "p95_seconds": {"type": "number", "minimum": 0}
          }
        },
        "peak_memory": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "method", "bytes"],
              "properties": {
                "status": {"const": "measured"},
                "method": {"type": "string", "minLength": 1},
                "bytes": {"type": "integer", "minimum": 0}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "diagnostic"],
              "properties": {
                "status": {"const": "unsupported"},
                "diagnostic": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "scaling": {
      "type": "object",
      "additionalProperties": true,
      "required": ["cases", "environment_fingerprint", "pass"],
      "properties": {
        "cases": {"type": "array", "minItems": 1},
        "environment_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pass": {"type": "boolean"}
      }
    },
    "stochastic": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "seed",
        "rng_generator",
        "realizations",
        "exactness_limit",
        "unbiasedness",
        "convergence",
        "pass"
      ],
      "properties": {
        "seed": {"type": "integer"},
        "rng_generator": {"type": "string", "minLength": 1},
        "realizations": {"type": "integer", "minimum": 32},
        "exactness_limit": {
          "type": "object",
          "additionalProperties": true,
          "required": ["enumerated_all_propagating_bins", "max_abs_error", "tolerance", "tolerance_basis", "pass"],
          "properties": {
            "enumerated_all_propagating_bins": {"const": true},
            "max_abs_error": {"type": "number", "minimum": 0},
            "tolerance": {"type": "number", "exclusiveMinimum": 0},
            "tolerance_basis": {"const": "dtype_roundoff_derived"},
            "pass": {"type": "boolean"}
          }
        },
        "unbiasedness": {
          "type": "object",
          "additionalProperties": true,
          "required": ["mean_error", "standard_error", "k_sigma", "pass"],
          "properties": {
            "mean_error": {"type": "number"},
            "standard_error": {"type": "number", "minimum": 0},
            "k_sigma": {"type": "number", "exclusiveMinimum": 0},
            "pass": {"type": "boolean"}
          }
        },
        "convergence": {
          "type": "object",
          "additionalProperties": true,
          "required": ["sweep", "fitted_exponent", "expected_exponent", "exponent_tolerance", "pass"],
          "properties": {
            "sweep": {"type": "array", "minItems": 5},
            "fitted_exponent": {"type": "number"},
            "expected_exponent": {"type": "number"},
            "exponent_tolerance": {"type": "number", "exclusiveMinimum": 0},
            "pass": {"type": "boolean"}
          }
        },
        "pass": {"type": "boolean"}
      }
    },
    "differentiability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["claim", "estimator", "omitted_terms", "finite_difference_comparison"],
      "properties": {
        "claim": {
          "enum": [
            "not_verified",
            "characterized_biased",
            "characterized_unbiased_in_regime",
            "verified"
          ]
        },
        "estimator": {"type": "string", "minLength": 1},
        "omitted_terms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "finite_difference_comparison": {"type": "object"}
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "branch",
        "scientific_fingerprint",
        "environment_fingerprint",
        "matching_environment_for_performance",
        "scientific_projection",
        "corrupted_fixture_rejection",
        "pass"
      ],
      "properties": {
        "branch": {"enum": ["ray", "wave", "coupler"]},
        "scientific_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "matching_environment_for_performance": {"type": "boolean"},
        "scientific_projection": {"type": "object"},
        "corrupted_fixture_rejection": {
          "type": "object",
          "required": ["fixture", "mutation", "evaluator_returncode", "detected"],
          "properties": {
            "fixture": {"type": "string", "minLength": 1},
            "mutation": {"type": "string", "minLength": 1},
            "evaluator_returncode": {"type": "integer", "minimum": 1},
            "detected": {"const": true}
          }
        },
        "pass": {"type": "boolean"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "stage", "exception_type"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "exception_type": {"type": ["string", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}},
      "then": {"required": ["accuracy", "performance"]}
    },
    {
      "if": {"properties": {"status": {"const": "blocked"}}},
      "then": {"required": ["failure"]}
    }
  ]
}
