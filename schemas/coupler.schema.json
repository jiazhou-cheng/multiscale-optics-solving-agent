{
  "$defs": {
    "ApproximationClass": {
      "enum": [
        "geometric_optics",
        "eikonal",
        "scalar_wave",
        "vector_wave",
        "tmm",
        "rcwa",
        "full_wave_em",
        "eigenmode",
        "photonic_circuit",
        "thermal",
        "mechanical",
        "sensor",
        "transformation"
      ],
      "title": "ApproximationClass",
      "type": "string"
    },
    "ArtifactKind": {
      "enum": [
        "optical_system",
        "ray_bundle",
        "wavefront_samples",
        "travel_time_field",
        "complex_field",
        "vector_field",
        "phase_profile",
        "periodic_structure",
        "diffraction_channels",
        "effective_surface",
        "material_field",
        "near_field_surface",
        "far_field_angular_spectrum",
        "mode_basis",
        "modal_amplitudes",
        "s_parameters",
        "circuit_component",
        "circuit_response",
        "psf",
        "otf",
        "sensor_image",
        "absorbed_power_density",
        "heat_source",
        "temperature_field",
        "displacement_field",
        "geometry_update"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "CostModelSpec": {
      "additionalProperties": false,
      "properties": {
        "estimator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimator"
        },
        "memory_scaling": {
          "default": "unknown",
          "title": "Memory Scaling",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "scaling": {
          "default": "unknown",
          "title": "Scaling",
          "type": "string"
        }
      },
      "title": "CostModelSpec",
      "type": "object"
    },
    "CouplerRole": {
      "description": "Which of the three kinds of operation a registered coupler is (CHE-142).\n\n``src/couplers/`` was using one word for three different things, so the\nregistry could not say which of them a caller was selecting. The rule:\n**representation transition != diffractive physical interaction !=\npropagation.** ``src/couplers/ontology.py`` holds the package-side partition\nand the test that keeps the two in step.\n\nThere is no default. A coupler row must say which it is, because the three\nanswer different questions and a guess would be wrong silently: a caller\nreading ``C_PLANAR_DOE_STEP``'s ray-in/ray-out ports cannot tell from them\nwhether the step re-described the light or diffracted it.",
      "enum": [
        "representation_transition",
        "diffractive_interaction",
        "propagation"
      ],
      "title": "CouplerRole",
      "type": "string"
    },
    "DerivativeMode": {
      "enum": [
        "native_autodiff",
        "custom_vjp",
        "custom_jvp",
        "adjoint",
        "implicit",
        "analytic",
        "surrogate",
        "finite_difference",
        "none"
      ],
      "title": "DerivativeMode",
      "type": "string"
    },
    "DerivativeSpec": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/DerivativeMode"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "parameters": {
          "items": {
            "type": "string"
          },
          "title": "Parameters",
          "type": "array"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "mode"
      ],
      "title": "DerivativeSpec",
      "type": "object"
    },
    "Device": {
      "enum": [
        "cpu",
        "gpu",
        "tpu",
        "external"
      ],
      "title": "Device",
      "type": "string"
    },
    "Framework": {
      "enum": [
        "jax",
        "pytorch",
        "numpy",
        "internal",
        "external"
      ],
      "title": "Framework",
      "type": "string"
    },
    "InteractionSpec": {
      "additionalProperties": false,
      "description": "The shared physical identity a group of coupler rows computes (CHE-142).\n\nTwo rows carrying the same ``id`` are the **same physical operation at\ndifferent granularities**, not two peer claims -- which is what\n``C_PLANAR_DOE_STEP`` and ``C_PATCH_WFT`` had been reading as. Each keeps its\nown capability row regardless: devices, dtypes and maturity genuinely differ\nbetween the models, and grouping them must not widen the narrower one.",
      "properties": {
        "id": {
          "pattern": "^I_[A-Z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "relation": {
          "minLength": 1,
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "model",
        "relation"
      ],
      "title": "InteractionSpec",
      "type": "object"
    },
    "Maturity": {
      "enum": [
        "experimental",
        "characterized",
        "validated",
        "deprecated"
      ],
      "title": "Maturity",
      "type": "string"
    },
    "PortSpec": {
      "additionalProperties": false,
      "description": "A physical input/output port, including semantic metadata.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "provides_metadata": {
          "items": {
            "type": "string"
          },
          "title": "Provides Metadata",
          "type": "array"
        },
        "requires_metadata": {
          "items": {
            "type": "string"
          },
          "title": "Requires Metadata",
          "type": "array"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "name",
        "artifact"
      ],
      "title": "PortSpec",
      "type": "object"
    },
    "SourceSpec": {
      "additionalProperties": false,
      "properties": {
        "docs_url": {
          "title": "Docs Url",
          "type": "string"
        },
        "package": {
          "title": "Package",
          "type": "string"
        },
        "pinned_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pinned Commit"
        },
        "pinned_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pinned Version"
        },
        "repository_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Url"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        }
      },
      "required": [
        "package",
        "docs_url"
      ],
      "title": "SourceSpec",
      "type": "object"
    },
    "ValiditySpec": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "hard_limits": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Hard Limits",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "ValiditySpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approximation": {
      "$ref": "#/$defs/ApproximationClass",
      "default": "transformation"
    },
    "cost_model": {
      "$ref": "#/$defs/CostModelSpec"
    },
    "derivative": {
      "$ref": "#/$defs/DerivativeSpec"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "devices": {
      "items": {
        "$ref": "#/$defs/Device"
      },
      "title": "Devices",
      "type": "array"
    },
    "dtypes": {
      "items": {
        "type": "string"
      },
      "title": "Dtypes",
      "type": "array"
    },
    "framework": {
      "$ref": "#/$defs/Framework"
    },
    "id": {
      "pattern": "^C_[A-Z0-9_]+$",
      "title": "Id",
      "type": "string"
    },
    "interaction": {
      "anyOf": [
        {
          "$ref": "#/$defs/InteractionSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "invariants": {
      "items": {
        "type": "string"
      },
      "title": "Invariants",
      "type": "array"
    },
    "lossy": {
      "default": false,
      "title": "Lossy",
      "type": "boolean"
    },
    "maturity": {
      "$ref": "#/$defs/Maturity",
      "default": "experimental"
    },
    "role": {
      "$ref": "#/$defs/CouplerRole"
    },
    "source": {
      "$ref": "#/$defs/PortSpec"
    },
    "source_info": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "target": {
      "$ref": "#/$defs/PortSpec"
    },
    "validity": {
      "$ref": "#/$defs/ValiditySpec"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "description",
    "framework",
    "role",
    "source",
    "target",
    "derivative"
  ],
  "title": "CouplerSpec",
  "type": "object"
}
