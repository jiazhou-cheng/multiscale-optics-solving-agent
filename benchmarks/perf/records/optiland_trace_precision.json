{
 "accuracy": {
  "direction_cosine_error": {
   "max": 5.676253693742694e-07
  },
  "optical_path_error_waves": {
   "max": 0.04450644041753549,
   "rms": 0.01106179331693124,
   "rms_degrees_of_phase": 3.9822455940952466,
   "wavelength_m": 7e-07
  },
  "oracle": "the fp64 trace of the same rays through the same prescription. Not an analytic oracle: it bounds what fp32 loses relative to fp64, which is the question precision-as-a-speed-knob raises, and says nothing about whether either matches the physics.",
  "sensor_position_error_um": {
   "max": 0.0021469898074463565,
   "rms": 0.0003941056785579901,
   "sensor_pitch_um": 4.2
  },
  "why_the_opd_is_the_one_that_matters": "demo3 accumulates a COHERENT field, so the traced optical path enters the result as a phase. A fraction-of-a-wave error is a phase error of 2 pi times that fraction and it does not average away over rays the way a position error well inside one sensor pixel does."
 },
 "chunk": {
  "prescription": "Demo3HologramLA1131A",
  "rays": 200000,
  "traced_surfaces": 4
 },
 "consequence": "Precision is not this issue's lever in either direction, and the acceptance criterion's warning does not bite: demo3 already runs fp32, so there is no faster-but-different trace on offer here. The useful conclusion runs the other way. Before CHE-118 the trace was 99 s and fp64 was a 12% surcharge on the largest stage in the run; after it the stage is a few seconds and fp64 is free within noise, so a future benchmark that needs a certified phase can simply pay for it. That matters because fp32's ~4 degrees RMS of traced phase is not obviously negligible in a coherent sum -- it is a pre-existing property of every demo3 record, not something this change introduces, and it is handed to the convergence work rather than resolved here.",
 "environment": {
  "container_image": "agent_solver",
  "cpu_model": "Intel(R) Xeon(R) Gold 6242R CPU @ 3.10GHz",
  "gpu_count": 1,
  "gpu_driver": "550.163.01",
  "gpu_name": "NVIDIA RTX A6000",
  "logical_cpus": 80,
  "packages": {
   "chromatix": "0.6.0",
   "jax": "0.6.2",
   "jaxlib": "0.6.2",
   "numpy": "2.2.6",
   "optiland": "0.6.0",
   "scipy": "1.15.3",
   "torch": "2.13.0+cu126"
  },
  "platform": "Linux-6.8.0-84-generic-x86_64-with-glibc2.41",
  "python_version": "3.12.14",
  "sha256": "fb66d7be8b4ad129b5e05807f3af88645c4e8aff3559a03e6d76914ed0d29f11",
  "thread_env": {},
  "visible_devices": null
 },
 "finding": "Precision barely moves this trace. On the arm that survives the CHE-118 fix the fp32 and fp64 costs are not separable at all -- the ratio sits inside the spread of two identical fp64 runs -- and even the per-ray-wavelength arm shows only 1.12x, nowhere near the ~32x this device's fp64:fp32 arithmetic throughput would suggest, because the trace is bound by kernel launches, memory traffic and host-side work rather than by arithmetic. What fp32 does cost is phase: 1.11e-02 waves RMS of optical path against the fp64 trace, i.e. about 4.0 degrees, with a maximum of 4.45e-02 waves.",
 "fp64_cost_ratio": {
  "solver_trace_per_ray_wavelength_s": {
   "fp64_over_fp32": 1.119,
   "noise_floor": 0.0108,
   "reading": "fp64 costs 1.12x the fp32 arm",
   "resolved_above_noise": true
  },
  "solver_trace_scalar_wavelength_s": {
   "fp64_over_fp32": 0.9905,
   "noise_floor": 0.004,
   "reading": "no measurable fp64 surcharge on this arm. The ratio is at or below one, which for the more expensive precision bounds the effect at the run-to-run spread rather than measuring a speedup",
   "resolved_above_noise": false
  },
  "whole_trace_ray_batch_s": {
   "fp64_over_fp32": 1.0211,
   "noise_floor": 0.019,
   "reading": "fp64 costs 1.02x the fp32 arm",
   "resolved_above_noise": true
  }
 },
