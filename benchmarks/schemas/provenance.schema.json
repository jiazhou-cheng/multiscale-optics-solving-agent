{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiscale-optics-agent.local/schemas/m1-provenance.schema.json",
  "title": "M1 baseline benchmark provenance",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "benchmark_id",
    "protocol_id",
    "command",
    "git_commit",
    "dirty_worktree",
    "python_version",
    "platform",
    "machine",
    "cpu_model",
    "logical_cpu_count",
    "process_cpu_affinity",
    "thread_counts",
    "device",
    "dtype",
    "seed",
    "engine_versions",
    "input_parameters",
    "artifact_hashes",
    "timestamp_utc"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"enum": ["L1-RAY-01", "L1-WAVE-01"]},
    "protocol_id": {"const": "M1-BASELINE-CPU-V1"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "git_commit": {"type": "string", "minLength": 7},
    "dirty_worktree": {"type": "boolean"},
    "python_version": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "machine": {"type": "string", "minLength": 1},
    "cpu_model": {"type": ["string", "null"]},
    "logical_cpu_count": {"type": "integer", "minimum": 1},
    "process_cpu_affinity": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "thread_counts": {"type": "object", "minProperties": 1},
    "device": {"const": "cpu"},
    "dtype": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "engine_versions": {"type": "object", "minProperties": 1},
    "input_parameters": {"type": "object"},
    "artifact_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "timestamp_utc": {"type": "string", "format": "date-time"}
  }
}
