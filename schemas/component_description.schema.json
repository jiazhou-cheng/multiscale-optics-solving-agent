{
  "$defs": {
    "FamilyCoverage": {
      "additionalProperties": false,
      "description": "Which benchmark families speak about a component, and what each can decide.\n\n``gate_deciding`` is the field that stops an agent planning against a B4\ncharacterization as though it were a validation.",
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "family_id": {
          "title": "Family Id",
          "type": "string"
        },
        "gate_deciding": {
          "title": "Gate Deciding",
          "type": "boolean"
        },
        "gate_status": {
          "title": "Gate Status",
          "type": "string"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "observed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "family_id",
        "category",
        "question",
        "gate_deciding",
        "gate_status"
      ],
      "title": "FamilyCoverage",
      "type": "object"
    },
    "KnowledgeView": {
      "additionalProperties": false,
      "description": "Which pack files exist for a component and which the policy permits.\n\nThe V1 agent harness's ``cold`` / ``warm`` / ``guided`` policies copy these\nby hand into a workspace. Formalizing the lookup here means M7 can vary the\npolicy without re-implementing file copying.",
      "properties": {
        "component": {
          "title": "Component",
          "type": "string"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        },
        "pack_root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pack Root"
        },
        "permitted_by_policy": {
          "items": {
            "type": "string"
          },
          "title": "Permitted By Policy",
          "type": "array"
        },
        "policy": {
          "default": "cold",
          "title": "Policy",
          "type": "string"
        },
        "present": {
          "items": {
            "type": "string"
          },
          "title": "Present",
          "type": "array"
        }
      },
      "required": [
        "component",
        "pack_root"
      ],
      "title": "KnowledgeView",
      "type": "object"
    },
    "PortView": {
      "additionalProperties": false,
      "description": "A port, with the metadata it requires and provides.\n\nDerived from ``registry/*.yaml``'s ``PortSpec``. The metadata lists are the\nconnection contract: a producer that provides nothing a consumer requires is\nan incompatible edge however well their artifact kinds match.",
      "properties": {
        "artifact": {
          "title": "Artifact",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "direction": {
          "title": "Direction",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "provides_metadata": {
          "items": {
            "type": "string"
          },
          "title": "Provides Metadata",
          "type": "array"
        },
        "requires_metadata": {
          "items": {
            "type": "string"
          },
          "title": "Requires Metadata",
          "type": "array"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "name",
        "artifact",
        "direction"
      ],
      "title": "PortView",
      "type": "object"
    },
    "RefusalView": {
      "additionalProperties": false,
      "description": "What happens if you get it wrong, from the M1.3 catalogue.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "could_have_proceeded": {
          "title": "Could Have Proceeded",
          "type": "boolean"
        },
        "remedy": {
          "title": "Remedy",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "trigger": {
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "code",
        "status",
        "trigger",
        "remedy",
        "could_have_proceeded"
      ],
      "title": "RefusalView",
      "type": "object"
    },
    "SuitabilityRecord": {
      "additionalProperties": false,
      "description": "One validity declaration, made machine-readable.\n\n``condition`` is the prose from the registry. ``predicate_id`` links it to an\nexecutable :class:`~verification.families.schema.ValidityPredicate` where a\nfamily has one; ``None`` means the declaration is still prose only, which is\na gap rather than a property and is reported as such.",
      "properties": {
        "condition": {
          "title": "Condition",
          "type": "string"
        },
        "declared_by_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared By Family"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "predicate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate Id"
        },
        "structurable": {
          "default": true,
          "title": "Structurable",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "condition"
      ],
      "title": "SuitabilityRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything one query can say about one component.\n\n\"Can\", \"should\", and \"what happens if I do it wrong\", answerable together.",
  "properties": {
    "approximation": {
      "title": "Approximation",
      "type": "string"
    },
    "capability_evidence": {
      "default": "",
      "title": "Capability Evidence",
      "type": "string"
    },
    "component": {
      "title": "Component",
      "type": "string"
    },
    "cost_model": {
      "additionalProperties": true,
      "title": "Cost Model",
      "type": "object"
    },
    "derivative_mode": {
      "default": "none",
      "title": "Derivative Mode",
      "type": "string"
    },
    "derivative_verified": {
      "default": false,
      "title": "Derivative Verified",
      "type": "boolean"
    },
    "derivative_warning": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Derivative Warning"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "device_namespaces": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Device Namespaces",
      "type": "object"
    },
    "devices": {
      "items": {
        "type": "string"
      },
      "title": "Devices",
      "type": "array"
    },
    "families": {
      "items": {
        "$ref": "#/$defs/FamilyCoverage"
      },
      "title": "Families",
      "type": "array"
    },
    "framework": {
      "title": "Framework",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/PortView"
      },
      "title": "Inputs",
      "type": "array"
    },
    "invariants": {
      "items": {
        "type": "string"
      },
      "title": "Invariants",
      "type": "array"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "knowledge": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnowledgeView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "lossy": {
      "default": false,
      "title": "Lossy",
      "type": "boolean"
    },
    "lossy_input_dtypes": {
      "items": {
        "type": "string"
      },
      "title": "Lossy Input Dtypes",
      "type": "array"
    },
    "maturity": {
      "title": "Maturity",
      "type": "string"
    },
    "namespaces": {
      "items": {
        "type": "string"
      },
      "title": "Namespaces",
      "type": "array"
    },
    "native_compute_dtypes": {
      "items": {
        "type": "string"
      },
      "title": "Native Compute Dtypes",
      "type": "array"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/PortView"
      },
      "title": "Outputs",
      "type": "array"
    },
    "precisions": {
      "items": {
        "type": "string"
      },
      "title": "Precisions",
      "type": "array"
    },
    "refusals": {
      "items": {
        "$ref": "#/$defs/RefusalView"
      },
      "title": "Refusals",
      "type": "array"
    },
    "suitability": {
      "items": {
        "$ref": "#/$defs/SuitabilityRecord"
      },
      "title": "Suitability",
      "type": "array"
    },
    "validation_claims": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Validation Claims",
      "type": "array"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "component",
    "version",
    "kind",
    "description",
    "approximation",
    "framework",
    "maturity"
  ],
  "title": "ComponentDescription",
  "type": "object"
}
