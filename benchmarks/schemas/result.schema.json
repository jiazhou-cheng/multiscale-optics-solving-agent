{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiscale-optics-agent.local/schemas/m1-result.schema.json",
  "title": "M1 baseline benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"enum": ["L1-RAY-01", "L1-WAVE-01"]},
    "status": {"enum": ["complete", "blocked"]},
    "accuracy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["oracle", "metrics", "tolerances", "pass"],
      "properties": {
        "oracle": {"type": "string", "minLength": 1},
        "metrics": {"type": "object"},
        "tolerances": {"type": "object"},
        "pass": {"type": "boolean"}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmup_runs",
        "measured_repeats",
        "samples_seconds",
        "statistics",
        "peak_memory"
      ],
      "properties": {
        "warmup_runs": {"type": "integer", "minimum": 1},
        "measured_repeats": {"type": "integer", "minimum": 5},
        "samples_seconds": {
          "type": "array",
          "minItems": 5,
          "items": {"type": "number", "minimum": 0}
        },
        "statistics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["median_seconds", "minimum_seconds", "p95_seconds"],
          "properties": {
            "median_seconds": {"type": "number", "minimum": 0},
            "minimum_seconds": {"type": "number", "minimum": 0},
            "p95_seconds": {"type": "number", "minimum": 0}
          }
        },
        "peak_memory": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "method", "bytes"],
              "properties": {
                "status": {"const": "measured"},
                "method": {"type": "string", "minLength": 1},
                "bytes": {"type": "integer", "minimum": 0}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "diagnostic"],
              "properties": {
                "status": {"const": "unsupported"},
                "diagnostic": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "stage", "exception_type"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "exception_type": {"type": ["string", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}},
      "then": {"required": ["accuracy", "performance"]}
    },
    {
      "if": {"properties": {"status": {"const": "blocked"}}},
      "then": {"required": ["failure"]}
    }
  ]
}
